generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MissionStatus {
  OPEN
  ENDING_SOON
  EXPIRED
  COMPLETED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  WINNER
}

enum LeaderboardKind {
  HUMAN
  AGENT
  COUNTRY
  MISSION
}

enum AdminActionType {
  MISSION_CREATED
  MISSION_EDITED
  MISSION_EXPIRED
  SUBMISSION_APPROVED
  SUBMISSION_REJECTED
  WINNER_MARKED
  AGENT_MANAGED
}

model User {
  id                String             @id @default(cuid())
  username          String?
  avatarUrl         String?
  rewardsEarned     Decimal            @default(0) @db.Decimal(12, 2)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  walletAccounts    WalletAccount[]
  xAccounts         XAccount[]
  missionsCreated   Mission[]          @relation("MissionCreator")
  joins             MissionJoin[]
  submissions       Submission[]
  rewardBoosts      RewardBoost[]
  leaderboardPoints LeaderboardPoint[]
  adminActions      AdminAction[]

  @@map("users")
}

model WalletAccount {
  id        String   @id @default(cuid())
  userId    String
  address   String   @unique
  chain     String   @default("solana")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallet_accounts")
}

model XAccount {
  id           String   @id @default(cuid())
  userId       String
  xUserId      String   @unique
  handle       String
  displayName  String?
  profileImage String?
  verified     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("x_accounts")
}

model Agent {
  id             String    @id @default(cuid())
  slug           String    @unique
  name           String
  handle         String?
  avatarUrl      String?
  avatarInitial  String?
  bio            String
  missionsCount  Int       @default(0)
  rewardsPaid    Decimal   @default(0) @db.Decimal(12, 2)
  supporters     Int       @default(0)
  trustScore     Decimal   @default(0) @db.Decimal(5, 2)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  missions       Mission[]

  @@map("agents")
}

model Mission {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  category       String
  description    String
  rules          String[]
  proof          String
  rewardPool     Decimal       @db.Decimal(12, 2)
  deadline       DateTime
  status         MissionStatus @default(OPEN)
  featured       Boolean       @default(false)
  country        String?
  agentId        String
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  agent          Agent         @relation(fields: [agentId], references: [id])
  createdBy      User?         @relation("MissionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  joins          MissionJoin[]
  submissions    Submission[]
  rewardBoosts   RewardBoost[]
  points         LeaderboardPoint[]

  @@map("missions")
}

model MissionJoin {
  id         String   @id @default(cuid())
  userId     String
  missionId  String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission    Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
  @@map("mission_joins")
}

model Submission {
  id              String           @id @default(cuid())
  userId          String
  missionId       String
  title           String
  description     String
  proofUrl        String
  xPostUrl        String
  mediaUrl        String?
  xPostId         String
  xAuthorId       String
  xAuthorHandle   String
  status          SubmissionStatus @default(PENDING)
  rejectionReason String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission         Mission          @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@map("submissions")
}

model RewardBoost {
  id          String   @id @default(cuid())
  userId      String
  missionId   String
  amount      Decimal  @db.Decimal(12, 2)
  txSignature String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission     Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@map("reward_boosts")
}

model LeaderboardPoint {
  id        String          @id @default(cuid())
  kind      LeaderboardKind
  points    Int
  label     String
  userId    String?
  missionId String?
  country   String?
  createdAt DateTime        @default(now())
  user      User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission   Mission?        @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@map("leaderboard_points")
}

model AdminAction {
  id          String          @id @default(cuid())
  adminUserId String?
  type        AdminActionType
  targetType  String
  targetId    String
  reason      String?
  metadata    Json?
  createdAt   DateTime        @default(now())
  adminUser   User?           @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@map("admin_actions")
}

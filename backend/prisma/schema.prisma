generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MissionStatus {
  OPEN
  ENDING_SOON
  EXPIRED
  COMPLETED
  UNDER_REVIEW
  REMOVED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  WINNER
  DISQUALIFIED
  PAID
}

enum PayoutStatus {
  UNPAID
  PAID
  FAILED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum AgentStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum AgentSource {
  LAZY
  CLAWPUMP
  EXTERNAL
}

enum MissionCreatedByType {
  ADMIN
  HUMAN
  AGENT_OWNER
  AGENT_API
  LAZARUS
}

enum RewardCurrency {
  USDC
  SOL
}

enum FundingTransactionType {
  MISSION_FUND
  BOOST
}

enum FundingStatus {
  PENDING
  FUNDED
  CONFIRMED
  FAILED
}

enum LeaderboardKind {
  HUMAN
  AGENT
  COUNTRY
  MISSION
}

enum AdminActionType {
  MISSION_CREATED
  MISSION_EDITED
  MISSION_EXPIRED
  SUBMISSION_APPROVED
  SUBMISSION_REJECTED
  WINNER_MARKED
  SUBMISSION_DISQUALIFIED
  SUBMISSION_PAID
  USER_SUSPENDED
  USER_UNSUSPENDED
  ADMIN_NOTE_ADDED
  AGENT_MANAGED
}

model User {
  id                String             @id @default(cuid())
  username          String?
  avatarUrl         String?
  status            UserStatus         @default(ACTIVE)
  rewardsEarned     Decimal            @default(0) @db.Decimal(12, 2)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  walletAccounts    WalletAccount[]
  xAccounts         XAccount[]
  missionsCreated   Mission[]          @relation("MissionCreator")
  joins             MissionJoin[]
  submissions       Submission[]
  rewardBoosts      RewardBoost[]
  leaderboardPoints LeaderboardPoint[]
  adminActions      AdminAction[]
  adminNotes        AdminNote[]
  adminNotesAuthored AdminNote[]       @relation("AdminNoteAuthor")

  @@map("users")
}

model WalletAccount {
  id        String   @id @default(cuid())
  userId    String
  address   String   @unique
  chain     String   @default("solana")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallet_accounts")
}

model XAccount {
  id           String   @id @default(cuid())
  userId       String
  xUserId      String   @unique
  handle       String
  displayName  String?
  profileImage String?
  verified     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("x_accounts")
}

model Agent {
  id             String    @id @default(cuid())
  slug           String    @unique
  name           String
  handle         String?
  avatarUrl      String?
  avatarInitial  String?
  bio            String
  category       String    @default("Agents")
  ownerWallet    String?
  approved       Boolean   @default(true)
  status         AgentStatus @default(APPROVED)
  source         AgentSource @default(EXTERNAL)
  externalAgentId String?
  website        String?
  xHandle        String?
  apiKeyHash     String?
  apiKeyCreatedAt DateTime?
  apiKeyLastUsedAt DateTime?
  featured       Boolean   @default(false)
  missionsCount  Int       @default(0)
  rewardsPaid    Decimal   @default(0) @db.Decimal(12, 2)
  supporters     Int       @default(0)
  trustScore     Decimal   @default(0) @db.Decimal(5, 2)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  missions       Mission[]

  @@map("agents")
}

model Mission {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  category       String
  description    String
  rules          String[]
  proof          String
  rewardPool     Decimal       @db.Decimal(18, 9)
  rewardCurrency RewardCurrency @default(USDC)
  prizePoolAmountSol Decimal?   @db.Decimal(18, 9)
  fundingTxHash  String?
  funderWallet   String?
  rewardWallet   String?
  fundingStatus  FundingStatus @default(PENDING)
  deadline       DateTime
  status         MissionStatus @default(OPEN)
  featured       Boolean       @default(false)
  country        String?
  agentId        String
  createdById    String?
  createdByType  MissionCreatedByType @default(ADMIN)
  createdByWallet String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  agent          Agent         @relation(fields: [agentId], references: [id])
  createdBy      User?         @relation("MissionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  joins          MissionJoin[]
  submissions    Submission[]
  rewardBoosts   RewardBoost[]
  points         LeaderboardPoint[]
  fundingTransactions FundingTransaction[]

  @@map("missions")
}

model MissionJoin {
  id         String   @id @default(cuid())
  userId     String
  missionId  String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission    Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
  @@map("mission_joins")
}

model Submission {
  id              String           @id @default(cuid())
  userId          String
  missionId       String
  title           String
  description     String
  proofUrl        String
  xPostUrl        String
  mediaUrl        String?
  xPostId         String
  xAuthorId       String
  xAuthorHandle   String
  status          SubmissionStatus @default(PENDING)
  rejectionReason String?
  adminNote       String?
  payoutAmount    Decimal?         @db.Decimal(18, 9)
  payoutCurrency  RewardCurrency   @default(USDC)
  payoutWallet    String?
  payoutTxHash    String?
  payoutStatus    PayoutStatus     @default(UNPAID)
  payoutNote      String?
  paidAt          DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission         Mission          @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@map("submissions")
}

model RewardBoost {
  id          String   @id @default(cuid())
  userId      String
  missionId   String
  amount      Decimal  @db.Decimal(18, 9)
  currency    RewardCurrency @default(USDC)
  amountSol   Decimal? @db.Decimal(18, 9)
  txSignature String?
  boosterWallet String?
  status      FundingStatus @default(PENDING)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission     Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  fundingTransactions FundingTransaction[]

  @@map("reward_boosts")
}

model FundingTransaction {
  id        String                 @id @default(cuid())
  txHash    String                 @unique
  type      FundingTransactionType
  missionId String?
  boostId   String?
  fromWallet String
  toWallet  String
  currency  RewardCurrency         @default(SOL)
  amount    Decimal                @default(0) @db.Decimal(18, 9)
  amountSol Decimal                @db.Decimal(18, 9)
  status    FundingStatus          @default(CONFIRMED)
  confirmedAt DateTime?
  createdAt DateTime               @default(now())
  mission   Mission?               @relation(fields: [missionId], references: [id], onDelete: Cascade)
  boost     RewardBoost?           @relation(fields: [boostId], references: [id], onDelete: Cascade)

  @@map("funding_transactions")
}

model LeaderboardPoint {
  id        String          @id @default(cuid())
  kind      LeaderboardKind
  points    Int
  label     String
  userId    String?
  missionId String?
  country   String?
  createdAt DateTime        @default(now())
  user      User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission   Mission?        @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@map("leaderboard_points")
}

model AdminAction {
  id          String          @id @default(cuid())
  adminUserId String?
  type        AdminActionType
  targetType  String
  targetId    String
  reason      String?
  metadata    Json?
  createdAt   DateTime        @default(now())
  adminUser   User?           @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@map("admin_actions")
}

model AdminNote {
  id          String   @id @default(cuid())
  userId      String
  adminUserId String?
  note        String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminUser   User?    @relation("AdminNoteAuthor", fields: [adminUserId], references: [id], onDelete: SetNull)

  @@map("admin_notes")
}

model LazarusMemory {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("lazarus_memory")
}

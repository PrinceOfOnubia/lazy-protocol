{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/:path*/styles.css",
      "destination": "/styles.css"
    },
    {
      "source": "/:path*/mock-data.js",
      "destination": "/mock-data.js"
    },
    {
      "source": "/:path*/app.js",
      "destination": "/app.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
